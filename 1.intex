<!DOCTYPE html>
<html lang="mk">

<head>
  <meta charset="UTF-8">
  <title>💘</title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <style>
    body {
      margin: 0;
      padding: 0;
      background: linear-gradient(135deg, #ff9a9e, #fad0c4);
      font-family: Arial, sans-serif;
      text-align: center;
      color: white;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow-x: hidden;
    }

    h1 {
      margin-top: 40px;
      font-size: clamp(24px, 6vw, 38px);
      padding: 0 15px;
      animation: fadeIn 2s ease-in-out;
    }

    img {
      margin-top: 20px;
      border-radius: 20px;
      width: 90%;
      max-width: 350px;
      height: auto;
    }

    /* BUTTONS */

    .buttons {
      margin-top: 30px;
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      position: relative;
      width: 100%;
      max-width: 400px;
      height: 120px;
    }

    button {
      padding: 12px 25px;
      font-size: 18px;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      transition: 0.2s ease;
      color: white;
      position: relative;
    }

    #yes {
      background: #ff4d6d;
    }

    #yes:hover {
      transform: scale(1.1);
    }

    #no {
      background: #6c757d;
    }

    /* POPUPS */

    .popup {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);

      justify-content: center;
      align-items: center;
      padding: 15px;
      box-sizing: border-box;
    }

    .popup-content {
      background: white;
      color: black;
      padding: 25px;
      border-radius: 25px;
      width: 100%;
      max-width: 380px;
      text-align: center;
      animation: fadeIn 0.4s ease;
    }

    /* MOOD CARDS */

    .mood-options {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 20px;
    }

    .mood-card {
      background: #ffe5ec;
      color: black;
      padding: 18px;
      border-radius: 20px;
      cursor: pointer;
      transition: 0.25s ease;
      font-size: 30px;

      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .mood-card span {
      font-size: 14px;
      font-weight: bold;
    }

    .mood-card:hover {
      transform: scale(1.08);
      background: #ffccd5;
    }

    .mood-card.active {
      background: #ff4d6d;
      color: white;
      transform: scale(1.08);
    }

    /* INPUTS */

    .date-time-box {
      margin-top: 20px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .input-box {
      text-align: left;
      margin-top: 15px;
    }

    .input-box label {
      display: block;
      margin-bottom: 8px;
      font-weight: bold;
    }

    .input-box input,
    .custom-select {
      width: 100%;
      padding: 12px;
      border-radius: 12px;
      border: 1px solid #ccc;
      font-size: 16px;
      box-sizing: border-box;
    }

    #next,
    #confirm {
      background: #ff4d6d;
      margin-top: 25px;
    }

    /* HEARTS */

    .heart {
      position: fixed;
      bottom: -20px;
      color: pink;
      animation: floatUp 6s linear infinite;
      pointer-events: none;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) scale(1);
        opacity: 1;
      }

      100% {
        transform: translateY(-100vh) scale(1.5);
        opacity: 0;
      }
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    .celebrate {
      animation: zoomIn 1s ease forwards;
    }

    @keyframes zoomIn {
      from {
        transform: scale(0);
      }

      to {
        transform: scale(1);
      }
    }

    footer {
      margin-top: auto;
      padding: 15px;
      color: black;
      font-weight: bold;
      font-size: 14px;
    }
  </style>
</head>

<body>

  <h1>Дали сакаш да дојдам? 💖</h1>

  <img src="avt.jpg" alt="avto">

  <div class="buttons">
    <button id="yes">Да 💕</button>
    <button id="no">Не 😢</button>
  </div>

  <!-- FIRST POPUP -->

  <div id="popup" class="popup">

    <div class="popup-content">

      <h2>Во кој mood си? 💖</h2>

      <div class="mood-options">

        <div class="mood-card" data-mood="🍔 Храна">
          🍔
          <span>Храна</span>
        </div>

        <div class="mood-card" data-mood="🎬 Netflix">
          🎬
          <span>Netflix</span>
        </div>

        <div class="mood-card" data-mood="💕 Sex">
          💕
          <span>Sex</span>
        </div>

      </div>

      <button id="next">Следно 💕</button>

    </div>

  </div>

  <!-- SECOND POPUP -->

  <div id="popup2" class="popup">

    <div class="popup-content">

      <h2>Детали 💖</h2>

      <div id="extra-options"></div>

      <div class="date-time-box">

        <div class="input-box">
          <label>📅 Датум</label>
          <input type="date" id="date">
        </div>

        <div class="input-box">
          <label>⏰ Време</label>
          <input type="time" id="time">
        </div>

      </div>

      <button id="confirm">Потврди 💕</button>

    </div>

  </div>

  <footer>
    Copyright © 2026 Design by Martin
  </footer>

  <script>

    const noBtn = document.getElementById("no");
    const yesBtn = document.getElementById("yes");

    const popup = document.getElementById("popup");
    const popup2 = document.getElementById("popup2");

    const nextBtn = document.getElementById("next");
    const confirmBtn = document.getElementById("confirm");

    const buttonsContainer = document.querySelector(".buttons");

    const moodCards = document.querySelectorAll(".mood-card");

    const extraOptions = document.getElementById("extra-options");

    let selectedMood = "";

    const noTexts = [
      "Не 😢",
      "Неее 😭",
      "Зашто? 🥺",
      "Дали си сигурна? 😳",
      "Размисли па 💔",
      "Стварно?? 😩",
      "Последна шанса😅"
    ];

    let textIndex = 0;

    // SELECT MOOD

    moodCards.forEach(card => {

      card.addEventListener("click", () => {

        moodCards.forEach(c => {
          c.classList.remove("active");
        });

        card.classList.add("active");

        selectedMood = card.dataset.mood;

      });

    });

    // MOVE NO BUTTON

    function moveButton() {

      const maxX = buttonsContainer.offsetWidth - noBtn.offsetWidth;
      const maxY = buttonsContainer.offsetHeight - noBtn.offsetHeight;

      const randomX = Math.random() * maxX;
      const randomY = Math.random() * maxY;

      noBtn.style.position = "absolute";
      noBtn.style.left = randomX + "px";
      noBtn.style.top = randomY + "px";

      textIndex = (textIndex + 1) % noTexts.length;

      noBtn.innerHTML = noTexts[textIndex];

      const currentSize =
        parseFloat(window.getComputedStyle(yesBtn).fontSize);

      yesBtn.style.fontSize = currentSize + 2 + "px";
    }

    // DESKTOP

    noBtn.addEventListener("mouseover", moveButton);

    // MOBILE

    noBtn.addEventListener("touchstart", moveButton);

    // YES BUTTON

    yesBtn.addEventListener("click", () => {

      popup.style.display = "flex";

    });

    // NEXT BUTTON

    nextBtn.addEventListener("click", () => {

      if (selectedMood === "") {

        alert("Избери mood 😄");

        return;
      }

      popup.style.display = "none";

      popup2.style.display = "flex";

      // FOOD

      if (selectedMood.includes("Храна")) {

        extraOptions.innerHTML = `

          <div class="input-box">

            <label>🍕 Каква храна?</label>

            <select id="foodType" class="custom-select">
              <option>🍕 Pizza</option>
              <option>🍔 Burger</option>
              <option>🌮 Taco</option>
              <option>🍣 Sushi</option>
              <option>🥩 Steak</option>
            </select>

          </div>

        `;
      }

      // NETFLIX

      else if (selectedMood.includes("Netflix")) {

        extraOptions.innerHTML = `

          <div class="input-box">

            <label>🎬 Кој филм/серија?</label>

            <input
              type="text"
              id="movieName"
              placeholder="Пример: Titanic 😄"
            >

          </div>

        `;
      }

      // SEX

      else if (selectedMood.includes("Sex")) {

        extraOptions.innerHTML = `

          <div class="input-box">

            <label>💕 Protection mode?</label>

            <select id="protection" class="custom-select">
              <option>🛡️ Со заштита</option>
              <option>😅 Без заштита</option>
            </select>

          </div>

        `;
      }

    });

    // CONFIRM BUTTON

    confirmBtn.addEventListener("click", () => {

      const date = document.getElementById("date").value;

      const time = document.getElementById("time").value;

      if (date === "" || time === "") {

        alert("Избери датум и време 💖");

        return;
      }

      let extraText = "";

      // FOOD

      if (selectedMood.includes("Храна")) {

        const food =
          document.getElementById("foodType").value;

        extraText = `🍽️ ${food}`;
      }

      // NETFLIX

      else if (selectedMood.includes("Netflix")) {

        const movie =
          document.getElementById("movieName").value;

        extraText = `🎥 ${movie}`;
      }

      // SEX

      else if (selectedMood.includes("Sex")) {

        const protection =
          document.getElementById("protection").value;

        extraText = `${protection}`;
      }

      document.body.innerHTML = `

        <h1 class="celebrate">

          YAYYYY!!! 💘🥰 <br><br>

          Mood: ${selectedMood} <br><br>

          ${extraText} <br><br>

          📅 ${date} <br>
          ⏰ ${time} 💕

        </h1>

        <img 
          src="gif.gif"
          style="
            width:90%;
            max-width:350px;
            border-radius:20px;
            margin-top:20px;
          "
        >

      `;

      createHeartsExplosion();

    });

    // HEARTS

    function createHearts() {

      const heart = document.createElement("div");

      heart.classList.add("heart");

      heart.innerHTML = "💖";

      heart.style.left = Math.random() * 100 + "vw";

      heart.style.fontSize =
        (Math.random() * 25 + 15) + "px";

      document.body.appendChild(heart);

      setTimeout(() => {

        heart.remove();

      }, 6000);
    }

    function createHeartsExplosion() {

      for (let i = 0; i < 70; i++) {

        createHearts();

      }
    }

    setInterval(createHearts, 300);

  </script>

</body>

</html>